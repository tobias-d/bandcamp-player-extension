{
  "name": "bandcamp-deck",
  "version": "3.6.2",
  "description": "Bandcamp Deck rebuild (v3)",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:firefox",
    "prep": "node tools/build/preflight-build-guard.js && node tools/build/copy-custom-essentia-wasm.js && node tools/build/patch-essentia-no-eval.js && node tools/build/generate-signalsmith-worklet.js && node tools/build/verify-signalsmith-worklet-feeding.js",
    "prebuild:firefox": "npm run prep",
    "build:firefox": "webpack --env target=firefox --mode production",
    "postbuild:firefox": "node tools/build/patch-webpack-no-eval.js firefox",
    "prebuild:chrome": "npm run prep",
    "build:chrome": "webpack --env target=chrome --mode production",
    "postbuild:chrome": "node tools/build/patch-webpack-no-eval.js chrome",
    "prebuild:dev": "npm run prep",
    "build:dev": "webpack --env target=firefox --mode development",
    "postbuild:dev": "node tools/build/patch-webpack-no-eval.js firefox",
    "release:firefox": "npm run build:firefox && node tools/build/capture-release.js firefox",
    "release:chrome": "npm run build:chrome && node tools/build/capture-release.js chrome",
    "release:all": "npm run release:firefox && npm run release:chrome",
    "prewatch": "npm run prep",
    "watch": "webpack --env target=firefox --watch",
    "clean": "rm -rf dist",
    "check:bpm-offset": "node tools/check-bpm-offset.mjs",
    "verify:worklet": "node tools/build/verify-signalsmith-worklet-feeding.js",
    "bump": "node tools/build/bump-version.js"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@types/chrome": "^0.1.36",
    "@types/node": "^25.2.3",
    "@types/webpack-env": "^1.18.8",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "essentia.js": "0.1.3",
    "process": "^0.11.10",
    "signalsmith-stretch": "1.3.2"
  }
}
