{
  "manifest_version": 3,
  "name": "Bandcamp Deck",
  "version": "3.7.1",
  "description": "The most complete DJ-ready Bandcamp player, with accurate BPM analysis, tempo adjust, waveform visualization, and more.",
  "permissions": ["storage", "offscreen", "tabs"],
  "host_permissions": [
    "*://*.bandcamp.com/*",
    "*://bandcamp.com/*",
    "*://*.bcbits.com/*",
    "*://*/album/*",
    "*://*/track/*"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bandcamp.com/*", "*://bandcamp.com/*"],
      "exclude_matches": [
        "*://bandcamp.com/discover*",
        "*://www.bandcamp.com/discover*",
        "*://bandcamp.com/download*",
        "*://www.bandcamp.com/download*",
        "*://bandcamp.com/lani_d/playlist/*",
        "*://www.bandcamp.com/lani_d/playlist/*",
        "*://*.bandcamp.com/cart/checkout*",
        "*://bandcamp.com/cart/checkout*",
        "*://www.bandcamp.com/cart/checkout*",
        "*://daily.bandcamp.com/*",
        "*://bandcamp.com/",
        "*://www.bandcamp.com/"
      ],
      "js": ["content/player/index.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://bandcamp.com/discover*", "*://www.bandcamp.com/discover*"],
      "js": ["content/discover/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["public/*", "public/fonts/*", "public/signalsmith/*", "essentia-wasm.wasm", "content/discover/origin-bridge.js"],
      "matches": ["*://*.bandcamp.com/*", "*://bandcamp.com/*"]
    }
  ],
  "action": {
    "default_title": "Bandcamp Player"
  }
}
